rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for role validation
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'admin' ||
        request.auth.token.admin == true
      );
    }
    
    function isResponder() {
      return isAuthenticated() && (
        getUserData().role == 'responder' ||
        request.auth.token.responder == true ||
        isAdmin()
      );
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // 2. Incidents collection
    match /incidents/{incidentId} {
      // Public users can create incidents and read non-confidential fields
      allow create: if true;
      allow read: if true;
      // Responders can update assigned incidents, Admins can update all
      allow update: if isAdmin() || (
        isResponder() && (
          resource.data.assignedTeamId == getUserData().teamId ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'responderNotes'])
        )
      );
      allow delete: if isAdmin();
    }

    // 3. Response Teams
    match /responseTeams/{teamId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Assignments
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 5. Missing Persons
    // Privacy: Public can read case description and public photo, but contact info restricted
    match /missingPersons/{caseId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == resource.data.reporterId);
      allow delete: if isAdmin();
    }

    // 6. Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 7. Facilities
    match /facilities/{facilityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. Incident Logs (Audit trail)
    match /incidentLogs/{logId} {
      allow read: if isResponder() || isAdmin();
      allow create: if isAuthenticated() || isResponder() || isAdmin();
      allow update, delete: if false; // Immutable audit log
    }
  }
}
